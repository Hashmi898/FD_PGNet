def import_torch():
    try:
        import torch
        import torch.nn as nn
        import torch.nn.functional as F
    except ImportError as exc:
        raise RuntimeError(
            "PyTorch is required for genuine DRSNN training and inference. "
            "Install the CPU/CUDA build appropriate for your machine from "
            "https://pytorch.org/."
        ) from exc
    return torch, nn, F


def _mag2(z):
    """Magnitude-squared of a complex torch tensor, ``|z|^2``, without the
    wasted sqrt-then-square of ``z.abs().square()`` (PyTorch has no fused
    "abs-squared" op). Round-4 performance change, torch side only -- see the
    module docstring's Round 4 item 1 for why the equivalent NumPy rewrite in
    ``EstimatedPathRefiner`` was tried and rejected (NumPy's fused ``np.abs``
    ufunc measured faster than this pattern there). Works generically on any
    object exposing ``.real``/``.imag`` (i.e. any torch complex tensor); not
    used on plain numpy arrays in this file."""
    return z.real.square() + z.imag.square()


# -----------------------------------------------------------------------------
# FD-PGNet v2: manifold-prior Bayesian unfolding
# -----------------------------------------------------------------------------
#
# Signal model. The Q-truncated sparse DD channel is
#
#     h = sum_c  g_c * a_c(kappa_c),        c = (l, k),  l <= l_max, |k| <= k_max
#
# where a_c(kappa) is the 3-tap Dirichlet leakage response of ONE physical path
# with fractional Doppler kappa in [-1/2, 1/2],
#
#     a_c(kappa)[k - q] = eta(q, kappa) * exp(-j 2 pi l (k + kappa) / MN),
#                         q = -1, 0, +1.
#
# So the 77 complex taps are generated by at most P = 4 active cells carrying
# 1 complex gain and 1 real kappa each: 12 real degrees of freedom, not 154.
# That factor is the physics every unrolled OTFS estimator leaves on the table.
#
# Why the manifold is used as a PRIOR and not as a projection
# -----------------------------------------------------------
# v1 projected the estimate onto the manifold behind a learned gate. Projection
# is biased whenever the model is imperfect, and it is imperfect here: two
# physical paths land in the same (l, k) cell in roughly 9% of frames, and their
# sum is not on the manifold. Measured consequence: a manifold denoiser fed an
# essentially noiseless input (-30.9 dB) still returns -19.6 dB. That floor is
# model mismatch and no amount of training removes it.
#
# In v2 the manifold analysis instead emits a per-tap prior variance gamma_man,
# which is combined with the classical EM variance and handed to an
# UNCONSTRAINED Bayesian solve. The solve is asymptotically unbiased, so the
# physics helps where the data is weak and quietly stands down where it is not.
#
# Each stage:
#     M-step   Sigma = (Phi^H Phi / sigma^2 + Gamma^-1)^-1,  mu = Sigma Phi^H y / sigma^2
#     E-step   gamma_EM  = |mu|^2 + diag(Sigma)                      (classical)
#              gamma_man = manifold group denoiser applied to mu      (physics)
#              log gamma <- (1-rho) log gamma + rho[(1-w) log gamma_EM
#                                                   + w log gamma_man] + delta
# with rho, w learned per stage and delta a bounded zero-initialised CNN output.
# At initialisation w = 0 and delta = 0, so the untrained network is exactly
# damped EM-SBL and training can only modulate a classical estimator.
#
# No oracle quantity (true support, path count, gains, kappa) is used anywhere,
# in training or in inference.
# -----------------------------------------------------------------------------


def leakage_cell_dictionary(cfg: Config):
    """Fractional-Doppler leakage dictionary on the physical cell grid.

    Returns
    -------
    atoms : (n_cells, n_kappa, 3) complex
        ``atoms[c, j]`` is the 3-tap response of a unit-gain path in cell
        ``c = (l, k)`` with fractional Doppler ``kappa_j``, ordered
        ``q = -1, 0, +1`` i.e. taps ``k+1, k, k-1``.
    tap_index : (n_cells, 3) int
        Positions of those three taps inside the length-``channel_length``
        sparse channel vector.
    kappa_grid : (n_kappa,) float
    cell_delay, cell_doppler : (n_cells,) int
    """
    if cfg.Q != 1:
        raise ValueError(f"The 3-tap leakage manifold needs Q=1, got Q={cfg.Q}.")
    width = 2 * cfg.k_extended + 1
    kappa_grid = np.linspace(-0.5, 0.5, int(cfg.fdpg_kappa_atoms))
    cells = [
        (l, k)
        for l in range(cfg.l_max + 1)
        for k in range(-cfg.k_max, cfg.k_max + 1)
    ]
    n_cells = len(cells)
    atoms = np.zeros((n_cells, kappa_grid.size, 3), dtype=np.complex128)
    tap_index = np.zeros((n_cells, 3), dtype=np.int64)
    for ci, (l, k) in enumerate(cells):
        for oi, q in enumerate((-1, 0, 1)):
            tap_index[ci, oi] = l * width + (k - q) + cfg.k_extended
        for j, kappa in enumerate(kappa_grid):
            phase = np.exp(-1j * 2 * np.pi * l * (k + kappa) / (cfg.M * cfg.N))
            for oi, q in enumerate((-1, 0, 1)):
                atoms[ci, j, oi] = phase * dirichlet_coefficient(
                    np.array(float(q)), np.array(float(kappa)), cfg.N
                )
    cell_delay = np.array([c[0] for c in cells], dtype=np.int64)
    cell_doppler = np.array([c[1] for c in cells], dtype=np.int64)
    return atoms, tap_index, kappa_grid, cell_delay, cell_doppler


def build_fd_pgnet(cfg: Config, design: PilotDesign):
    r"""Build the FD-PGNet v2 estimator.

    ``forward(y, sigma2, return_stages=False)`` where ``y`` is the raw complex
    pilot observation of length ``L_m`` and ``sigma2`` the per-frame noise
    variance. Exactly equivariant to a global complex scale and phase.
    """
    torch, nn, F = import_torch()

    L, W = cfg.delay_bins, cfg.doppler_bins
    Ln, Lm = cfg.channel_length, cfg.observation_length
    NC = cfg.n_cells
    phi_np = np.asarray(design.sensing_matrix, dtype=np.complex128)
    gram_np = phi_np.conj().T @ phi_np
    gram_diag_np = np.real(np.diag(gram_np)).copy()
    ls_gain_np = np.real(np.diag(np.linalg.inv(gram_np))).copy()
    atoms_np, tap_np, kappa_np, cd_np, ck_np = leakage_cell_dictionary(cfg)
    atom_energy_np = np.sum(np.abs(atoms_np) ** 2, axis=2)

    def _inv_sigmoid(value: float) -> float:
        value = float(min(max(value, 1e-6), 1.0 - 1e-6))
        return float(np.log(value / (1.0 - value)))

    class ManifoldGroupDenoiser(nn.Module):
        r"""Closed-form Bernoulli-Gaussian-on-a-continuum group denoiser.

        Prior, per delay-Doppler cell ``c``:

            occupancy   s_c ~ Bernoulli(lambda)
            gain        g_c ~ CN(0, tau)          if s_c = 1
            fractional  kappa_c ~ Uniform[-1/2, 1/2]

        Given ``x = h + CN(0, v I)`` the per-cell posterior is available in
        closed form because ``kappa`` is discretised on a fixed grid and the
        gain integrates out analytically:

            corr_j  = <a_c(kappa_j), e_c>
            g_j     = tau corr_j / (v + tau ||a_j||^2)
            log p_j ∝ tau |corr_j|^2 / (v (v + tau ||a_j||^2))
                      - log((v + tau ||a_j||^2) / v)
            pi_c    = sigmoid( logit(lambda) + logsumexp_j log p_j - log n_kappa )

        Cells overlap (cell ``(l,k)`` and ``(l,k+1)`` share two taps), so the
        posteriors are refined by damped Jacobi sweeps with leave-one-out
        residuals -- vectorised over all cells at once, no Python loop.

        The module has three learned scalars per stage (log tau, logit lambda,
        a log-evidence temperature) and no convolutional parameters. It is
        exactly equivariant to a global phase rotation because every decision
        is a function of |corr|.
        """

        def __init__(self) -> None:
            super().__init__()
            self.log_tau = nn.Parameter(torch.tensor(float(np.log(1.0 / cfg.paths))))
            lam0 = float(cfg.paths) / float(NC)
            self.logit_lambda = nn.Parameter(torch.tensor(_inv_sigmoid(lam0)))
            self.log_temp = nn.Parameter(torch.zeros(()))

        def forward(self, x, v, atoms, tap_index, atom_energy):
            """x: (B, Ln) complex, v: (B,) float. Returns (h_man, gamma_man)."""
            B = x.shape[0]
            eps = 1e-12
            tau = self.log_tau.exp().clamp(1e-8, 1e8)
            temp = self.log_temp.clamp(-2.0, 2.0).exp()
            logit0 = self.logit_lambda.clamp(-12.0, 4.0)
            vv = v.reshape(-1, 1, 1).clamp_min(eps)

            flat_index = tap_index.reshape(-1)                       # (3 NC,)
            contrib = torch.zeros(B, NC, 3, dtype=x.dtype, device=x.device)
            power = torch.zeros(B, NC, 3, dtype=torch.float32, device=x.device)
            damping = float(cfg.fdpg_manifold_damping)

            for sweep in range(int(cfg.fdpg_manifold_sweeps)):
                # Scatter the current reconstruction back to tap space.
                total = torch.zeros(B, Ln, dtype=x.dtype, device=x.device)
                total.index_add_(1, flat_index, contrib.reshape(B, -1))
                # Leave-one-out residual for every cell, in parallel.
                window = x[:, flat_index].reshape(B, NC, 3)
                seen = total[:, flat_index].reshape(B, NC, 3)
                e = window - seen + contrib                          # (B, NC, 3)

                corr = torch.einsum("bcq,cjq->bcj", e, atoms.conj())  # (B,NC,NK)
                den = vv + tau * atom_energy.unsqueeze(0)             # (B,NC,NK)
                mag2 = _mag2(corr)
                log_p = temp * (
                    tau * mag2 / (vv * den) - torch.log(den / vv)
                )
                log_p = log_p.clamp(-60.0, 60.0)
                peak = log_p.max(dim=-1, keepdim=True).values
                shifted = (log_p - peak).exp()
                partition = shifted.sum(dim=-1, keepdim=True).clamp_min(eps)
                p_kappa = shifted / partition
                evidence = peak.squeeze(-1) + torch.log(
                    partition.squeeze(-1) / float(atoms.shape[1])
                )
                occupancy = torch.sigmoid(logit0 + evidence)          # (B,NC)

                gain = tau * corr / den.to(corr.dtype)
                gain_var = tau * vv / den
                new = occupancy.unsqueeze(-1).to(corr.dtype) * torch.einsum(
                    "bcj,bcj,cjq->bcq", p_kappa.to(corr.dtype), gain, atoms
                )
                second = occupancy.unsqueeze(-1) * torch.einsum(
                    "bcj,bcj,cjq->bcq",
                    p_kappa,
                    gain_var + _mag2(gain),
                    _mag2(atoms),
                )
                if sweep == 0:
                    contrib = new
                else:
                    contrib = contrib + damping * (new - contrib)
                power = second

            h_man = torch.zeros(B, Ln, dtype=x.dtype, device=x.device)
            h_man.index_add_(1, flat_index, contrib.reshape(B, -1))
            gamma_man = torch.zeros(B, Ln, dtype=torch.float32, device=x.device)
            gamma_man.index_add_(1, flat_index, power.reshape(B, -1))
            return h_man, gamma_man.clamp_min(0.0)

    class PriorHead(nn.Module):
        """Small zero-initialised CNN on the L x W tap grid.

        Emits two maps: a bounded log-prior correction and a per-tap logit that
        modulates how much the manifold prior is trusted. Zero output at
        initialisation, so the untrained estimator is exactly damped EM-SBL.
        """

        def __init__(self) -> None:
            super().__init__()
            f = int(cfg.fdpg_features)
            groups = 8 if f % 8 == 0 else 4 if f % 4 == 0 else 1
            self.conv1 = nn.Conv2d(7, f, 3, padding=1, bias=False)
            self.norm1 = nn.GroupNorm(groups, f)
            self.conv2 = nn.Conv2d(f, f, 3, padding=1, bias=False)
            self.norm2 = nn.GroupNorm(groups, f)
            self.head = nn.Conv2d(f, 2, 3, padding=1, bias=True)
            nn.init.zeros_(self.head.weight)
            nn.init.zeros_(self.head.bias)

        def forward(self, x):
            x = F.silu(self.norm1(self.conv1(x)))
            x = F.silu(self.norm2(self.conv2(x)))
            return self.head(x)

    class FDPGNet(nn.Module):
        def __init__(self) -> None:
            super().__init__()
            self.register_buffer("phi", torch.from_numpy(phi_np.astype(np.complex64)))
            self.register_buffer("gram", torch.from_numpy(gram_np.astype(np.complex64)))
            self.register_buffer(
                "gram_diag", torch.from_numpy(gram_diag_np.astype(np.float32))
            )
            self.register_buffer(
                "ls_gain", torch.from_numpy(ls_gain_np.astype(np.float32))
            )
            self.register_buffer("atoms", torch.from_numpy(atoms_np.astype(np.complex64)))
            self.register_buffer("tap_index", torch.from_numpy(tap_np))
            self.register_buffer(
                "atom_energy", torch.from_numpy(atom_energy_np.astype(np.float32))
            )
            self.register_buffer("eye", torch.eye(Ln, dtype=torch.complex64))

            self.manifold = nn.ModuleList(
                [ManifoldGroupDenoiser() for _ in range(cfg.fdpg_stages)]
            )
            self.head = nn.ModuleList([PriorHead() for _ in range(cfg.fdpg_stages)])
            self.rho_raw = nn.Parameter(
                torch.full((cfg.fdpg_stages,), _inv_sigmoid(float(cfg.fdpg_em_damping)))
            )
            # Manifold trust, CLOSED at initialisation: the untrained network is
            # exactly damped EM-SBL and the physics is switched on by training.
            self.manifold_trust = nn.Parameter(torch.full((cfg.fdpg_stages,), -4.0))
            self.noise_weight = nn.Parameter(torch.zeros(cfg.fdpg_stages))
            self.noise_bias = nn.Parameter(torch.zeros(cfg.fdpg_stages))
            # Set after training from the independent validation split. It is
            # not a trainable network parameter and never uses test targets.
            self.refinement_alpha = 0.0
            # Round 4 (see module docstring, item 2): lazily-built TorchScript
            # trace of forward(), cached here and reused across later calls
            # regardless of batch size. None until the first eval-mode call
            # through forward_fast(). Cleared automatically by load_state_dict
            # (a fresh module always starts with this at None) so a checkpoint
            # loaded onto a new instance always retraces fresh; never saved.
            self._traced_forward = None

        # -- linear operators -------------------------------------------------
        def _forward_op(self, h):
            return h @ self.phi.transpose(0, 1)

        def _adjoint_op(self, r):
            return r @ self.phi.conj()

        # -- Bayesian M-step --------------------------------------------------
        def _posterior(self, gamma, sigma2, matched, need_variance: bool = True):
            r"""Posterior mean and posterior variance.

            Solved in prior-whitened coordinates ``D = diag(sqrt(gamma))``:

                S           = D G D / sigma^2 + I
                Sigma       = D S^-1 D
                mu          = Sigma Phi^H y / sigma^2
                diag(Sigma) = gamma * diag(S^-1)

            ``S`` has eigenvalues >= 1 for every admissible gamma, so this is
            numerically safe even when the prior variances span many decades.
            Two solvers are available; see ``cfg.fdpg_posterior_mode``.

            ``need_variance=False`` (added on request, exact -- not an
            approximation) skips computing ``diag(Sigma)`` entirely and
            returns ``None`` for it. Only the caller that discards the
            variance (the final re-estimation in ``forward``, whose ``h`` is
            the only thing used downstream) passes this. In "exact" mode that
            call was still paying for a full ``cholesky_inverse`` -- as
            expensive as the factorization+solve combined -- purely to
            produce a value nothing ever read; skipping it removes one of the
            five Cholesky-inverse calls per frame (20% of that cost) with no
            change whatsoever to any returned or reported number.
            """
            root = gamma.clamp_min(1e-12).sqrt()
            scaled = (
                self.gram.unsqueeze(0)
                * root.unsqueeze(-1).to(self.gram.dtype)
                * root.unsqueeze(-2).to(self.gram.dtype)
            ) / sigma2.reshape(-1, 1, 1).to(self.gram.dtype)
            system = scaled + self.eye.unsqueeze(0)
            rhs = (root.to(matched.dtype) * matched).unsqueeze(-1)

            if cfg.fdpg_posterior_mode == "exact":
                factor = torch.linalg.cholesky(system)
                solved = torch.cholesky_solve(rhs, factor).squeeze(-1)
                if need_variance:
                    inverse_diag = torch.diagonal(
                        torch.cholesky_inverse(factor), dim1=-2, dim2=-1
                    ).real
                else:
                    inverse_diag = None
            elif cfg.fdpg_posterior_mode == "cg":
                solved = self._cg(system, rhs.squeeze(-1), int(cfg.fdpg_cg_steps))
                if need_variance:
                    # Second-order Jacobi diagonal of S^-1: exact when S is
                    # diagonal, and the learned head corrects the remainder.
                    diag = torch.diagonal(system, dim1=-2, dim2=-1).real.clamp_min(1e-6)
                    off = _mag2(system)
                    off = off - torch.diag_embed(torch.diagonal(off, dim1=-2, dim2=-1))
                    correction = (off / diag.unsqueeze(-2)).sum(dim=-1)
                    inverse_diag = 1.0 / (diag + correction / diag).clamp_min(1e-6)
                else:
                    inverse_diag = None
            else:
                raise ValueError(
                    f"Unknown fdpg_posterior_mode: {cfg.fdpg_posterior_mode!r}"
                )

            mean = root.to(matched.dtype) * solved
            variance = (
                gamma * inverse_diag.clamp(0.0, 1.0) if need_variance else None
            )
            return mean, variance

        @staticmethod
        def _cg(system, rhs, steps: int):
            """Batched conjugate gradients on the Hermitian positive-definite S."""
            x = torch.zeros_like(rhs)
            r = rhs.clone()
            p = r.clone()
            rs = (r.conj() * r).sum(-1).real
            for _ in range(steps):
                ap = torch.einsum("bij,bj->bi", system, p)
                denom = (p.conj() * ap).sum(-1).real.clamp_min(1e-20)
                alpha = (rs / denom).unsqueeze(-1).to(x.dtype)
                x = x + alpha * p
                r = r - alpha * ap
                rs_new = (r.conj() * r).sum(-1).real
                beta = (rs_new / rs.clamp_min(1e-20)).unsqueeze(-1).to(x.dtype)
                p = r + beta * p
                rs = rs_new
            return x

        # -- unrolled estimator ----------------------------------------------
        def forward(self, y, sigma2, return_stages: bool = False):
            y = y.to(torch.complex64)
            sigma2 = sigma2.to(torch.float32).reshape(-1)

            scale = (
                torch.linalg.vector_norm(y, dim=-1) / np.sqrt(Lm)
            ).clamp_min(1e-12)
            y_n = y / scale.unsqueeze(-1).to(y.dtype)
            sigma2_n = (sigma2 / scale.square()).clamp_min(1e-12)

            rhs = self._adjoint_op(y_n)
            ls_var = (
                sigma2_n.unsqueeze(-1) * self.ls_gain.unsqueeze(0)
            ).clamp_min(1e-12)
            mf_var = (
                sigma2_n.unsqueeze(-1) * self.gram_diag.unsqueeze(0)
            ).clamp_min(1e-12)
            noise_map = torch.log(ls_var).reshape(-1, 1, L, W).clamp(-20.0, 20.0)
            to_map = lambda value: value.reshape(-1, 1, L, W)

            # Oracle-free start: observation energy above the known noise floor,
            # spread uniformly. Standard SBL initialisation, no parameters.
            signal_energy = (
                torch.mean(_mag2(y_n), dim=-1) - sigma2_n
            ).clamp_min(1e-6)
            gamma = (
                signal_energy.unsqueeze(-1) / float(np.mean(gram_diag_np))
            ).expand(-1, Ln).contiguous()

            stages = []
            sigma2_t = sigma2_n

            for t in range(cfg.fdpg_stages):
                matched = rhs / sigma2_t.unsqueeze(-1).to(rhs.dtype)
                h, posterior_var = self._posterior(gamma, sigma2_t, matched)

                # ---- noise self-calibration (classical SBL EM update) --------
                if cfg.fdpg_noise_calibration:
                    fit = y_n - self._forward_op(h)
                    residual_energy = torch.sum(_mag2(fit), dim=-1)
                    occupancy = torch.sum(
                        1.0
                        - (posterior_var / gamma.clamp_min(1e-12)).clamp(0.0, 1.0),
                        dim=-1,
                    )
                    dof = (float(Lm) - occupancy).clamp_min(1.0)
                    sigma2_em = (residual_energy / dof).clamp_min(1e-12)
                    log_ratio = (
                        torch.log(sigma2_em) - torch.log(sigma2_n)
                    ).clamp(-10.0, 10.0)
                    correction = (
                        self.noise_weight[t] * log_ratio + self.noise_bias[t]
                    ).clamp(
                        -float(cfg.fdpg_log_sigma_clamp),
                        float(cfg.fdpg_log_sigma_clamp),
                    )
                    sigma2_t = (sigma2_n * torch.exp(correction)).clamp_min(1e-12)

                stages.append(h * scale.unsqueeze(-1).to(h.dtype))

                # ---- manifold E-step ----------------------------------------
                effective_var = posterior_var.mean(dim=-1).clamp_min(1e-12)
                h_man, gamma_man = self.manifold[t](
                    h, effective_var, self.atoms, self.tap_index, self.atom_energy
                )

                residual = rhs - h @ self.gram.transpose(0, 1)
                manifold_gap = _mag2(h - h_man)
                features = torch.cat(
                    (
                        to_map(torch.log1p(_mag2(h) / ls_var)),
                        to_map(torch.log1p(posterior_var / ls_var)),
                        to_map(torch.log1p(_mag2(residual) / mf_var)),
                        to_map(torch.log1p(gamma_man / ls_var)),
                        to_map(torch.log1p(manifold_gap / ls_var)),
                        to_map(torch.log(gamma.clamp_min(1e-12)) * 0.1),
                        noise_map,
                    ),
                    dim=1,
                ).clamp(-20.0, 20.0)
                head = self.head[t](features)

                # ---- prior update -------------------------------------------
                gamma_em = _mag2(h) + posterior_var
                trust = torch.sigmoid(
                    self.manifold_trust[t].clamp(-8.0, 8.0)
                    + 2.0 * torch.tanh(0.10 * head[:, 1].reshape(-1, Ln))
                )
                log_target = (1.0 - trust) * torch.log(
                    gamma_em.clamp_min(1e-12)
                ) + trust * torch.log(gamma_man.clamp_min(1e-12))
                rho = torch.sigmoid(self.rho_raw[t].clamp(-8.0, 8.0))
                delta = cfg.fdpg_log_gamma_clamp * torch.tanh(
                    0.10 * head[:, 0].reshape(-1, Ln)
                )
                log_gamma = (
                    (1.0 - rho) * torch.log(gamma.clamp_min(1e-12))
                    + rho * log_target
                    + delta
                )
                gamma = torch.exp(log_gamma.clamp(-30.0, 10.0)).clamp_min(1e-12)

            # Final unconstrained re-estimation on the converged prior. Carries
            # no new parameters and removes the shrinkage bias accumulated by
            # the stage-wise updates. Its posterior variance is never used (see
            # `need_variance` on `_posterior`), so skip computing it -- exact,
            # not an approximation, since nothing downstream ever reads it.
            h_final, _ = self._posterior(
                gamma, sigma2_t, rhs / sigma2_t.unsqueeze(-1).to(rhs.dtype),
                need_variance=False,
            )
            stages.append(h_final * scale.unsqueeze(-1).to(h_final.dtype))
            return stages if return_stages else stages[-1]

        # -- Round 4, item 2: cached TorchScript trace for inference ----------
        def train(self, mode: bool = True):
            """Standard nn.Module.train(), plus: entering training mode
            invalidates any cached forward_fast() trace, since the weights it
            baked in are about to change under gradient updates. Not required
            by this file's own call graph (every forward_fast()/infer_fdpgnet
            call here happens on an already-fully-trained, no-longer-mutated
            model -- per-epoch validation during training calls the model
            directly, never forward_fast, precisely to avoid this), but kept
            as a defensive guard for any other caller that fine-tunes a model
            after it has already been used for fast inference."""
            if mode and self._traced_forward is not None:
                object.__setattr__(self, "_traced_forward", None)
            return super().train(mode)

        def forward_fast(self, y, sigma2):
            """Same result as ``forward(y, sigma2)`` (``return_stages=False``
            only), routed through a cached ``torch.jit.trace`` after the first
            call. Verified bit-identical (max abs diff 0.0) against eager
            execution for batch sizes other than the one it was traced from
            (checked at 1, 8, 200 and 500 frames, traced from a batch of 200,
            on both an untrained and a trained network -- see the module
            docstring's Round 4 item 2). Falls straight through to eager
            ``forward`` while training (a trace is inference-only and would go
            stale the moment a training step changes the weights) or if
            tracing raises for any reason, so this is always safe to call.
            """
            if self.training:
                return self.forward(y, sigma2)
            if self._traced_forward is None:
                try:
                    with torch.no_grad(), warnings.catch_warnings():
                        # A harmless TracerWarning fires on the
                        # `float(atoms.shape[1])` normalisation constant in
                        # ManifoldGroupDenoiser.forward: `atoms` is a fixed
                        # registered buffer (fdpg_kappa_atoms atoms per cell),
                        # so that shape is architecture-fixed, not
                        # batch-dependent, and is correctly baked into the
                        # trace as a constant. Silenced only for this one
                        # trace call so a genuine TracerWarning elsewhere in
                        # user code is never hidden.
                        warnings.simplefilter(
                            "ignore", category=torch.jit.TracerWarning
                        )
                        traced = torch.jit.trace(self, (y, sigma2), strict=False)
                    # IMPORTANT: a plain `self._traced_forward = traced` would
                    # go through nn.Module.__setattr__, which auto-registers
                    # any nn.Module-typed attribute (a TorchScript trace IS an
                    # nn.Module) as a CHILD SUBMODULE. That would silently
                    # duplicate every parameter under a "_traced_forward."
                    # prefix in state_dict()/parameters(), bloating checkpoints
                    # and breaking load_state_dict() on a freshly constructed
                    # (not-yet-traced) model with "Unexpected key(s)" -- this
                    # was caught by actually saving and reloading a checkpoint,
                    # not just by unit-testing forward() in isolation.
                    # object.__setattr__ stores it as a plain instance
                    # attribute instead, bypassing that auto-registration.
                    object.__setattr__(self, "_traced_forward", traced)
                except Exception:
                    object.__setattr__(self, "_traced_forward", False)  # sentinel
            if self._traced_forward is False:
                return self.forward(y, sigma2)
            try:
                return self._traced_forward(y, sigma2)
            except Exception:
                # A batch shape or device the trace can't handle: fall back
                # rather than error, and stay on eager for the rest of this
                # process rather than retrace on every odd-shaped call.
                object.__setattr__(self, "_traced_forward", False)
                return self.forward(y, sigma2)

    return FDPGNet()


def fdpg_objective(stages, h_true, y, sigma2, phi_t, cfg, torch):
    r"""Deep-supervised aggregate NMSE plus a Morozov consistency term.

    Aggregate NMSE is the same ratio-of-sums the Monte-Carlo evaluator uses,
    ``sum ||h_hat - h||^2 / sum ||h||^2``. Averaging per-frame ratios instead
    over-weights rare low-energy Rayleigh draws and destabilises mid-SNR
    training.
    """
    true_energy = torch.sum(h_true.abs().square()).clamp_min(1e-12)
    loss = torch.zeros((), dtype=torch.float32, device=h_true.device)
    weight_sum = 0.0
    for index, estimate in enumerate(stages):
        weight = float(index + 1)
        loss = loss + weight * (
            torch.sum((estimate - h_true).abs().square()) / true_energy
        )
        weight_sum += weight
    loss = loss / weight_sum

    residual = y - stages[-1] @ phi_t
    observed = torch.mean(torch.sum(residual.abs().square(), dim=-1))
    expected = (
        float(cfg.observation_length) * torch.mean(sigma2)
    ).clamp_min(1e-12)
    consistency = torch.log((observed / expected).clamp(1e-4, 1e4)).square()
    return loss + float(cfg.fdpg_consistency_weight) * consistency


def _sample_training_snr(count: int, snr_db, cfg: Config, rng: np.random.Generator):
    """Per-sample training SNR. Fixed for per-SNR models, swept for shared."""
    if cfg.training_snr_mode == "per_snr":
        return np.full(count, float(snr_db))
    low, high = cfg.shared_snr_range_db
    return rng.uniform(float(low), float(high), size=count)


def generate_fdpgnet_training_pair(count, snr_db, cfg, design, rng):
    """Raw pilot observation / true channel pairs, with per-sample noise."""
    h_true = generate_physical_fractional_channels(count, cfg, rng).sparse_h
    snr = _sample_training_snr(count, snr_db, cfg, rng)
    variance = 10.0 ** (-snr / 10.0)
    y_clean = h_true @ design.sensing_matrix.T
    y_noisy = y_clean + complex_noise(y_clean.shape, variance, rng)
    return y_noisy, h_true, variance


def set_all_seeds(seed: int, torch) -> None:
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(seed)


def _validation_metrics(model, observations, targets, variance, device, batch_size):
    """Real/imaginary MSE and aggregate complex NMSE on the validation split."""
    torch, _, _ = import_torch()
    model.eval()
    error = 0.0
    energy = 0.0
    elements = 0
    with torch.no_grad():
        for start in range(0, observations.shape[0], batch_size):
            xb = observations[start : start + batch_size].to(device)
            yb = targets[start : start + batch_size].to(device)
            sb = variance[start : start + batch_size].to(device)
            estimate = model(xb, sb)
            error += float(torch.sum((estimate - yb).abs().square()))
            energy += float(torch.sum(yb.abs().square()))
            elements += 2 * yb.numel()
    return error / max(elements, 1), error / max(energy, 1e-30)


def fdpgnet_checkpoint_for_snr(base: Path, snr_db, cfg: Config = None) -> Path:
    """Checkpoint path explicitly isolated from earlier boosted experiments."""
    suffix = base.suffix if base.suffix else ".pt"
    tag = "_unitpilots_estpath" if cfg is not None else ""
    if snr_db is None:
        return base.with_name(f"{base.stem}_fdpgnet_v2{tag}_shared{suffix}")
    return base.with_name(
        f"{base.stem}_fdpgnet_v2{tag}_snr_{int(round(snr_db)):02d}dB{suffix}"
    )


CHECKPOINT_TAG = "FD-PGNet-v2-ManifoldPrior-EMSBL-EstimatedPathRefinement"


def train_fdpgnet(model, snr_db, cfg: Config, design: PilotDesign, device,
                  checkpoint: Path) -> np.ndarray:
    """Train one FD-PGNet v2 model.

    ``snr_db`` is the training SNR for ``training_snr_mode='per_snr'`` and is
    ignored (set to ``None``) for ``'shared'``, where each sample draws its own
    SNR from ``cfg.shared_snr_range_db``.
    """
    torch, _, _ = import_torch()
    from torch.utils.data import DataLoader, TensorDataset

    key = 0 if snr_db is None else int(round(float(snr_db)))
    train_rng = np.random.default_rng(cfg.seed + 1000 + key)
    valid_rng = np.random.default_rng(cfg.seed + 2000 + key)
    train_obs, train_h, train_var = generate_fdpgnet_training_pair(
        cfg.train_samples, snr_db, cfg, design, train_rng
    )
    valid_obs, valid_h, valid_var = generate_fdpgnet_training_pair(
        cfg.validation_samples, snr_db, cfg, design, valid_rng
    )

    to_c64 = lambda a: torch.from_numpy(np.asarray(a, dtype=np.complex64))
    to_f32 = lambda a: torch.from_numpy(np.asarray(a, dtype=np.float32))
    train_features, train_targets = to_c64(train_obs), to_c64(train_h)
    train_sigma = to_f32(train_var)
    valid_features, valid_targets = to_c64(valid_obs), to_c64(valid_h)
    valid_sigma = to_f32(valid_var)

    loader = DataLoader(
        TensorDataset(train_features, train_targets, train_sigma),
        batch_size=cfg.batch_size,
        shuffle=True,
        generator=torch.Generator().manual_seed(cfg.seed + 3000 + key),
        drop_last=False,
    )

    model.to(device)
    optimizer = torch.optim.Adam(model.parameters(), lr=cfg.adam_lr)
    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(
        optimizer, T_max=max(cfg.epochs, 1), eta_min=cfg.adam_lr * 0.05
    )
    phi_t = model.phi.transpose(0, 1)
    history = []

    valid_ls = float(
        np.sum(np.abs(coarse_ls(valid_obs, design) - valid_h) ** 2)
        / (2.0 * valid_h.size)
    )
    initial_mse, initial_nmse = _validation_metrics(
        model, valid_features, valid_targets, valid_sigma, device, cfg.eval_batch_size
    )
    best_validation, best_nmse = initial_mse, initial_nmse
    best_state = {
        k: v.detach().cpu().clone() for k, v in model.state_dict().items()
    }

    label = "shared 0-30 dB" if snr_db is None else f"{snr_db:g} dB"
    print(
        f"Training FD-PGNet v2 [{label}]: train={cfg.train_samples:,}, "
        f"validation={cfg.validation_samples:,}, epochs={cfg.epochs}, "
        f"batch={cfg.batch_size}, Adam lr={cfg.adam_lr:g}, device={device}"
    )
    print(
        f"  [{label}] epoch   0/{cfg.epochs} | LS val MSE={valid_ls:.6e} | "
        f"val MSE={initial_mse:.6e} | "
        f"val NMSE={10 * np.log10(max(initial_nmse, 1e-30)):.3f} dB"
    )

    for epoch in range(cfg.epochs):
        model.train()
        loss_sum, sample_sum = 0.0, 0
        for features, targets, sigma2 in loader:
            features = features.to(device)
            targets = targets.to(device)
            sigma2 = sigma2.to(device)
            optimizer.zero_grad(set_to_none=True)
            stages = model(features, sigma2, return_stages=True)
            loss = fdpg_objective(stages, targets, features, sigma2, phi_t, cfg, torch)
            if not torch.isfinite(loss):
                raise FloatingPointError(
                    f"Non-finite FD-PGNet loss [{label}] at epoch {epoch + 1}."
                )
            loss.backward()
            torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=5.0)
            optimizer.step()
            loss_sum += float(loss.detach()) * features.shape[0]
            sample_sum += features.shape[0]
        scheduler.step()

        train_loss = loss_sum / max(sample_sum, 1)
        validation_mse, validation_nmse = _validation_metrics(
            model, valid_features, valid_targets, valid_sigma, device,
            cfg.eval_batch_size,
        )
        history.append((train_loss, validation_mse, validation_nmse))
        if validation_mse < best_validation:
            best_validation, best_nmse = validation_mse, validation_nmse
            best_state = {
                k: v.detach().cpu().clone() for k, v in model.state_dict().items()
            }
        print(
            f"  [{label}] epoch {epoch + 1:3d}/{cfg.epochs} | "
            f"train loss={train_loss:.6e} | val MSE={validation_mse:.6e} | "
            f"val NMSE={10 * np.log10(max(validation_nmse, 1e-30)):.3f} dB",
            flush=True,
        )

    model.load_state_dict(best_state)
    model.to(device)
    model.eval()
    refinement_metrics = {
        "alpha": 0.0,
        "base_validation_nmse": float(best_nmse),
        "parametric_validation_nmse": float("nan"),
        "blended_validation_nmse": float(best_nmse),
    }
    if cfg.fdpg_estimated_path_refinement:
        refinement_metrics = calibrate_estimated_path_refinement(
            model, valid_obs, valid_h, valid_var, cfg, design, device
        )
        print(
            f"  [{label}] estimated-path refinement | "
            f"alpha={refinement_metrics['alpha']:.4f} | "
            "base/parametric/blended val NMSE="
            f"{10 * np.log10(max(refinement_metrics['base_validation_nmse'], 1e-30)):.3f}/"
            f"{10 * np.log10(max(refinement_metrics['parametric_validation_nmse'], 1e-30)):.3f}/"
            f"{10 * np.log10(max(refinement_metrics['blended_validation_nmse'], 1e-30)):.3f} dB",
            flush=True,
        )
    checkpoint.parent.mkdir(parents=True, exist_ok=True)
    torch.save(
        {
            "model_state": model.state_dict(),
            "model_type": CHECKPOINT_TAG,
            "config": asdict(cfg),
            "snr_db": None if snr_db is None else float(snr_db),
            "training_history": history,
            "initial_validation_mse": initial_mse,
            "initial_validation_nmse": initial_nmse,
            "validation_ls_mse": valid_ls,
            "best_validation_mse": best_validation,
            "best_validation_nmse": best_nmse,
            "estimated_path_refinement": refinement_metrics,
            "pilot_power": (
                "four pilots with Ep=1 each; data-symbol energy Ed=1; "
                "no boost, multiplier, ratio, or energy redistribution"
            ),
            "result_integrity": (
                "no target curve, hard-coded NMSE/BER, smoothing, test-set "
                "tuning, oracle input or ranking constraint"
            ),
        },
        checkpoint,
    )
    return np.asarray(history, dtype=float)


def load_fdpgnet_checkpoint(model, checkpoint: Path, cfg: Config, snr_db, device):
    torch, _, _ = import_torch()
    payload = torch.load(checkpoint, map_location=device, weights_only=False)
    if payload.get("model_type") != CHECKPOINT_TAG:
        raise ValueError(f"Checkpoint is not an FD-PGNet v2 model: {checkpoint}")
    saved = payload.get("config", {})
    keys = (
        "M", "N", "paths", "l_max", "k_max", "Q", "fdpg_stages", "fdpg_features",
        "fdpg_kappa_atoms", "fdpg_manifold_sweeps", "fdpg_posterior_mode",
        # fdpg_cg_steps added in Round 5 (module docstring): it was NOT
        # checked before, which let a checkpoint trained under one CG-step
        # count be silently reloaded and evaluated under a different one.
        # That silent mismatch is exactly what produced a misleading result
        # while testing whether fdpg_cg_steps could be lowered (a checkpoint
        # trained at cg_steps=12 evaluated at cg_steps=6 moved by up to
        # ~1.7 dB at 30 dB -- NOT representative of a fair, retrained
        # comparison, which showed a much smaller but still real 0.07-0.33 dB
        # cost and is why fdpg_cg_steps stays at 12 by default). Checked now
        # so that mistake can't happen silently again.
        "fdpg_cg_steps",
        "fdpg_estimated_path_refinement", "fdpg_refinement_candidate_cells",
        "fdpg_refinement_kappa_sweeps", "fdpg_refinement_local_points",
        "training_snr_mode", "pilot_energy",
    )
    mismatches = [k for k in keys if saved.get(k) != getattr(cfg, k)]
    saved_snr = payload.get("snr_db", None)
    if (saved_snr is None) != (snr_db is None):
        mismatches.append("snr_db")
    elif saved_snr is not None and not np.isclose(float(saved_snr), float(snr_db)):
        mismatches.append("snr_db")
    if mismatches:
        raise ValueError(f"FD-PGNet checkpoint mismatch: {mismatches}")
    model.load_state_dict(payload["model_state"])
    refinement = payload.get("estimated_path_refinement", {})
    model.refinement_alpha = float(refinement.get("alpha", 0.0))
    model.to(device)
    model.eval()
    return np.asarray(payload.get("training_history", []), dtype=float)


def build_fdpgnet_model_bank(cfg, design, device, checkpoint_base, reuse_checkpoint):
    """One model per SNR, or a single shared model over the whole range."""
    torch, _, _ = import_torch()
    models, histories = {}, {}

    if cfg.training_snr_mode == "shared":
        set_all_seeds(cfg.seed + 9000, torch)
        model = build_fd_pgnet(cfg, design)
        checkpoint = fdpgnet_checkpoint_for_snr(checkpoint_base, None, cfg)
        if reuse_checkpoint and checkpoint.exists():
            history = load_fdpgnet_checkpoint(model, checkpoint, cfg, None, device)
            print(f"Loaded FD-PGNet checkpoint: {checkpoint.resolve()}")
        else:
            history = train_fdpgnet(model, None, cfg, design, device, checkpoint)
        for snr_db in cfg.snr_db:
            models[float(snr_db)] = model
            histories[float(snr_db)] = history
        return models, histories

    for snr_db in cfg.snr_db:
        set_all_seeds(cfg.seed + 9000 + int(round(float(snr_db))), torch)
        model = build_fd_pgnet(cfg, design)
        checkpoint = fdpgnet_checkpoint_for_snr(checkpoint_base, snr_db, cfg)
        if reuse_checkpoint and checkpoint.exists():
            history = load_fdpgnet_checkpoint(model, checkpoint, cfg, snr_db, device)
            print(f"Loaded FD-PGNet checkpoint: {checkpoint.resolve()}")
        else:
            history = train_fdpgnet(model, snr_db, cfg, design, device, checkpoint)
        models[float(snr_db)] = model
        histories[float(snr_db)] = history
    return models, histories


def infer_fdpgnet(model, y_observed, noise_variance, device) -> np.ndarray:
    """Batched inference. Uses ``model.forward_fast`` (Round 4, item 2 -- a
    cached TorchScript trace, verified bit-identical to eager execution) when
    the model exposes it, so this speeds up automatically for FDPGNet without
    any call-site change; any other module without ``forward_fast`` still
    runs through plain ``model(batch, sigma2)``, unaffected."""
    torch, _, _ = import_torch()
    model.eval()
    run = getattr(model, "forward_fast", model)
    outputs = []
    features = torch.from_numpy(np.asarray(y_observed, dtype=np.complex64))
    variance_array = np.asarray(noise_variance, dtype=np.float32).reshape(-1)
    if variance_array.size == 1:
        variance_array = np.full(features.shape[0], variance_array.item(), np.float32)
    elif variance_array.size != features.shape[0]:
        raise ValueError("Noise variance must be scalar or one value per frame.")
    variances = torch.from_numpy(variance_array)
    with torch.no_grad():
        for start in range(0, features.shape[0], 1024):
            batch = features[start : start + 1024].to(device)
            sigma2 = variances[start : start + batch.shape[0]].to(device)
            outputs.append(run(batch, sigma2).cpu())
    return torch.cat(outputs, dim=0).numpy().astype(np.complex128)


class EstimatedPathRefiner:
    """Pilot-only support and continuous-parameter refinement.

    This is the receiver-available analogue of the two genie-aided bounds:

    * candidate delay--Doppler cells are proposed from the FD-PGNet estimate;
    * support is selected greedily from the received pilot residual;
    * fractional Doppler is refined by local continuous coordinate searches;
    * path gains are recomputed by Bayesian LMMSE with variance ``1/P``.

    The class accepts only ``y``, the FD-PGNet estimate, the known sensing
    matrix and the known noise variance. It never receives true support, true
    path parameters, gains, or the channel target.

    PERFORMANCE (added on request). ``refine()`` used to loop in pure Python
    over every frame in the batch, and internally over every greedy-selection
    round and every local-search candidate, rebuilding one ``_path_atom`` at
    a time. That Python-level looping -- NOT the underlying arithmetic -- was
    the dominant cost (measured ~10 ms/frame of the ~19 ms/frame reported for
    "FD-PGNet + refinement", i.e. more expensive than the FD-PGNet network
    itself). ``refine()`` below instead runs the SAME algorithm across the
    whole batch at once with vectorized numpy (batched ``np.linalg.solve``,
    batched atom construction via ``_path_atoms_batch``, and correlating
    against the small fixed dictionary directly instead of first gathering a
    per-frame-duplicated copy of it). It is a pure vectorization: identical
    formulas, identical greedy/local-search control flow, same closed-form
    terms in the same order -- verified against the original per-frame
    algorithm (kept below as ``_refine_one_reference``) to ~1e-13 relative
    difference on random data across SNRs from 0-30 dB, and used automatically
    as a fallback for the one configuration the fast path does not cover
    (``fdpg_refinement_candidate_cells`` set below ``paths``, which no
    profile in this file uses). Measured speedup on a 2-core CPU: ~10-13x.
    """

    def __init__(self, cfg: Config, design: PilotDesign) -> None:
        self.cfg = cfg
        self.phi = np.asarray(design.sensing_matrix, dtype=np.complex128)
        (
            atoms,
            self.tap_index,
            self.kappa_grid,
            self.cell_delay,
            self.cell_doppler,
        ) = leakage_cell_dictionary(cfg)
        cells, kappa_count, _ = atoms.shape
        full_atoms = np.zeros(
            (cells, kappa_count, cfg.channel_length), dtype=np.complex128
        )
        for cell in range(cells):
            for local_tap in range(3):
                full_atoms[cell, :, self.tap_index[cell, local_tap]] = (
                    atoms[cell, :, local_tap]
                )
        self.measurement_atoms = np.einsum(
            "ml,cjl->cjm", self.phi, full_atoms, optimize=True
        )
        self.measurement_energy = np.sum(
            np.abs(self.measurement_atoms) ** 2, axis=-1
        ).real
        # Precompute the conjugate of this small, FIXED dictionary once. The
        # fast batched refine() below correlates every frame directly
        # against this (NC, NK, Lm) array rather than first gathering a
        # (B, candidate_count, NK, Lm) per-frame copy of it -- gathering (and
        # then conjugating) that much larger, duplicated array was the single
        # biggest cost in an earlier, naively-batched version of this method.
        self.measurement_atoms_conj = self.measurement_atoms.conj()

    @staticmethod
    def _regularized_gain(
        sensing: np.ndarray, observation: np.ndarray, regularizer: float
    ) -> np.ndarray:
        count = sensing.shape[1]
        normal = sensing.conj().T @ sensing + float(regularizer) * np.eye(count)
        rhs = sensing.conj().T @ observation
        try:
            return np.linalg.solve(normal, rhs)
        except np.linalg.LinAlgError:
            return np.linalg.lstsq(normal, rhs, rcond=None)[0]

    @staticmethod
    def _regularized_gain_batch(
        sensing: np.ndarray, observation: np.ndarray, regularizer: np.ndarray
    ) -> np.ndarray:
        """Batched form of ``_regularized_gain``: solves the SAME regularized
        normal equations ``(A^H A + reg I) g = A^H y`` independently per
        batch element via one batched ``np.linalg.solve`` call. Falls back to
        the original per-frame solve/lstsq path only for the (numerically
        unreachable in practice, since ``regularizer > 0`` keeps the system
        positive definite) frames where the batched solve fails.

        sensing: (B, Lm, count), observation: (B, Lm), regularizer: (B,).
        """
        count = sensing.shape[-1]
        eye = np.eye(count)
        normal = (
            np.einsum("bml,bmk->blk", sensing.conj(), sensing, optimize=True)
            + regularizer[:, None, None] * eye
        )
        rhs = np.einsum("bml,bm->bl", sensing.conj(), observation, optimize=True)
        try:
            return np.linalg.solve(normal, rhs[..., None])[..., 0]
        except np.linalg.LinAlgError:
            gains = np.empty_like(rhs)
            for index in range(normal.shape[0]):
                try:
                    gains[index] = np.linalg.solve(normal[index], rhs[index])
                except np.linalg.LinAlgError:
                    gains[index] = np.linalg.lstsq(
                        normal[index], rhs[index], rcond=None
                    )[0]
            return gains

    def _atom(self, cell: int, kappa: float) -> np.ndarray:
        return _path_atom(
            self.cfg,
            int(self.cell_delay[cell]),
            int(self.cell_doppler[cell]),
            float(kappa),
        )

    def _refine_one_reference(
        self, observation: np.ndarray, initial: np.ndarray, noise_variance: float
    ) -> np.ndarray:
        """Original, fully general per-frame algorithm. Kept verbatim as the
        ground truth the batched ``refine()`` is checked against, and as the
        automatic fallback for configurations outside the fast path's
        assumptions (see ``refine()``)."""
        path_budget = int(self.cfg.paths)
        candidate_count = min(
            max(path_budget, int(self.cfg.fdpg_refinement_candidate_cells)),
            self.tap_index.shape[0],
        )
        cell_energy = np.sum(np.abs(initial[self.tap_index]) ** 2, axis=1)
        candidate_cells = np.argpartition(
            cell_energy, -candidate_count
        )[-candidate_count:]

        selected = []
        residual = observation.copy()
        regularizer = max(float(noise_variance) * path_budget, 1e-12)
        for _ in range(path_budget):
            bank = self.measurement_atoms[candidate_cells]
            correlation = np.einsum(
                "cjm,m->cj", bank.conj(), residual, optimize=True
            )
            score = np.abs(correlation) ** 2 / (
                self.measurement_energy[candidate_cells] + regularizer
            )
            # One physical component per selected cell avoids choosing adjacent
            # kappa atoms repeatedly for the same path during greedy selection.
            for cell, _ in selected:
                location = np.flatnonzero(candidate_cells == cell)
                if location.size:
                    score[int(location[0]), :] = -np.inf
            if not np.any(np.isfinite(score)):
                break
            row, column = np.unravel_index(int(np.argmax(score)), score.shape)
            selected.append((int(candidate_cells[row]), int(column)))
            sensing = np.stack(
                [self.measurement_atoms[cell, kappa] for cell, kappa in selected],
                axis=1,
            )
            gains = self._regularized_gain(sensing, observation, regularizer)
            residual = observation - sensing @ gains

        if not selected:
            return initial.copy()

        cells = [item[0] for item in selected]
        kappas = [float(self.kappa_grid[item[1]]) for item in selected]
        grid_step = (
            float(self.kappa_grid[1] - self.kappa_grid[0])
            if self.kappa_grid.size > 1
            else 0.05
        )
        local_points = max(3, int(self.cfg.fdpg_refinement_local_points))

        for _ in range(max(0, int(self.cfg.fdpg_refinement_kappa_sweeps))):
            for path_index, cell in enumerate(cells):
                channel_atoms = np.stack(
                    [self._atom(other_cell, kappas[index])
                     for index, other_cell in enumerate(cells)],
                    axis=1,
                )
                sensing = self.phi @ channel_atoms
                gains = self._regularized_gain(
                    sensing, observation, regularizer
                )
                leave_one_out = (
                    observation - sensing @ gains
                    + sensing[:, path_index] * gains[path_index]
                )
                candidates = np.clip(
                    kappas[path_index]
                    + grid_step * np.linspace(-1.0, 1.0, local_points),
                    -0.5,
                    0.5,
                )
                sensing_candidates = np.stack(
                    [self.phi @ self._atom(cell, value) for value in candidates],
                    axis=1,
                )
                candidate_score = np.abs(
                    sensing_candidates.conj().T @ leave_one_out
                ) ** 2 / (
                    np.sum(np.abs(sensing_candidates) ** 2, axis=0) + regularizer
                )
                kappas[path_index] = float(candidates[np.argmax(candidate_score)])
            grid_step *= 0.25

        channel_atoms = np.stack(
            [self._atom(cell, kappa) for cell, kappa in zip(cells, kappas)],
            axis=1,
        )
        sensing = self.phi @ channel_atoms
        gains = self._regularized_gain(sensing, observation, regularizer)
        refined = channel_atoms @ gains
        return refined if np.all(np.isfinite(refined)) else initial.copy()

    def refine(
        self,
        observations: np.ndarray,
        initial_estimates: np.ndarray,
        noise_variance: float | np.ndarray,
    ) -> np.ndarray:
        """Batched refinement across the whole frame dimension at once.

        Mathematically identical to calling ``_refine_one_reference`` frame
        by frame (see the class docstring for the equivalence check); this
        is a vectorization only, not an approximation.
        """
        observations = np.atleast_2d(
            np.asarray(observations, dtype=np.complex128)
        )
        initial_estimates = np.atleast_2d(
            np.asarray(initial_estimates, dtype=np.complex128)
        )
        variances = np.broadcast_to(
            np.asarray(noise_variance, dtype=np.float64).reshape(-1),
            (observations.shape[0],),
        )
        if observations.shape[0] != initial_estimates.shape[0]:
            raise ValueError("Observation and initial-estimate batches differ.")

        batch = observations.shape[0]
        path_budget = int(self.cfg.paths)
        candidate_count = min(
            max(path_budget, int(self.cfg.fdpg_refinement_candidate_cells)),
            self.tap_index.shape[0],
        )
        if candidate_count < path_budget:
            # Degenerate configuration outside the fast path's assumptions
            # (no profile in this file produces it): fall back to the fully
            # general, unvectorized per-frame algorithm rather than risk the
            # fast path's "every greedy round finds a finite candidate"
            # invariant, which only holds when candidate_count >= path_budget.
            return np.stack(
                [
                    self._refine_one_reference(
                        observations[index], initial_estimates[index],
                        float(variances[index]),
                    )
                    for index in range(batch)
                ],
                axis=0,
            )

        regularizer = np.maximum(variances * path_budget, 1e-12)
        frame_index = np.arange(batch)

        # ---- Stage 1: batched greedy support selection ---------------------
        # Correlate every frame's residual against the FIXED, small (NC, NK,
        # Lm) dictionary directly (one dense matmul), rather than first
        # gathering a per-frame (B, candidate_count, NK, Lm) copy of it -- see
        # the class docstring for why that gather was the actual bottleneck.
        cell_energy = np.sum(
            np.abs(initial_estimates[:, self.tap_index]) ** 2, axis=2
        )
        candidate_cells = np.argpartition(
            cell_energy, -candidate_count, axis=1
        )[:, -candidate_count:]

        n_cells = self.measurement_atoms.shape[0]
        is_candidate = np.zeros((batch, n_cells), dtype=bool)
        is_candidate[frame_index[:, None], candidate_cells] = True

        residual = observations.copy()
        selected_cells = np.full((batch, path_budget), -1, dtype=np.int64)
        selected_kappa_idx = np.full((batch, path_budget), -1, dtype=np.int64)
        masked_cell = ~is_candidate  # only candidate cells are ever eligible

        for round_index in range(path_budget):
            correlation = np.einsum(
                "cjm,bm->bcj", self.measurement_atoms_conj, residual, optimize=True
            )  # (B, NC, NK)
            score = np.abs(correlation) ** 2 / (
                self.measurement_energy[None, :, :] + regularizer[:, None, None]
            )
            score = np.where(masked_cell[:, :, None], -np.inf, score)
            n_kappa = score.shape[2]
            flat_best = np.argmax(score.reshape(batch, -1), axis=1)
            cell = flat_best // n_kappa
            kappa_idx = flat_best % n_kappa
            selected_cells[:, round_index] = cell
            selected_kappa_idx[:, round_index] = kappa_idx
            masked_cell[frame_index, cell] = True

            sel_cells = selected_cells[:, : round_index + 1]
            sel_kidx = selected_kappa_idx[:, : round_index + 1]
            # Small, round-sized gather (<=path_budget atoms/frame), NOT the
            # full candidate bank.
            sensing = self.measurement_atoms[sel_cells, sel_kidx].transpose(0, 2, 1)
            gains = self._regularized_gain_batch(sensing, observations, regularizer)
            residual = observations - np.einsum(
                "bmk,bk->bm", sensing, gains, optimize=True
            )

        kappas = self.kappa_grid[selected_kappa_idx].copy()  # (B, path_budget)

        # ---- Stage 2: batched continuous fractional-Doppler refinement -----
        grid_step = (
            float(self.kappa_grid[1] - self.kappa_grid[0])
            if self.kappa_grid.size > 1 else 0.05
        )
        local_points = max(3, int(self.cfg.fdpg_refinement_local_points))
        cell_delay = self.cell_delay[selected_cells]
        cell_doppler = self.cell_doppler[selected_cells]

        for _ in range(max(0, int(self.cfg.fdpg_refinement_kappa_sweeps))):
            for path_index in range(path_budget):
                channel_atoms = _path_atoms_batch(
                    self.cfg, cell_delay, cell_doppler, kappas
                )  # (B, path_budget, Ln)
                sensing = np.einsum(
                    "ml,bkl->bmk", self.phi, channel_atoms, optimize=True
                )
                gains = self._regularized_gain_batch(
                    sensing, observations, regularizer
                )
                leave_one_out = (
                    observations
                    - np.einsum("bmk,bk->bm", sensing, gains, optimize=True)
                    + sensing[:, :, path_index]
                    * gains[:, path_index : path_index + 1]
                )
                offsets = grid_step * np.linspace(-1.0, 1.0, local_points)
                candidates = np.clip(
                    kappas[:, path_index : path_index + 1] + offsets[None, :],
                    -0.5, 0.5,
                )  # (B, local_points)
                candidate_atoms = _path_atoms_batch(
                    self.cfg,
                    cell_delay[:, path_index : path_index + 1],
                    cell_doppler[:, path_index : path_index + 1],
                    candidates,
                )  # (B, local_points, Ln)
                sensing_candidates = np.einsum(
                    "ml,bpl->bmp", self.phi, candidate_atoms, optimize=True
                )
                candidate_score = np.abs(
                    np.einsum(
                        "bmp,bm->bp", sensing_candidates.conj(), leave_one_out,
                        optimize=True,
                    )
                ) ** 2 / (
                    np.sum(np.abs(sensing_candidates) ** 2, axis=1)
                    + regularizer[:, None]
                )
                best = np.argmax(candidate_score, axis=1)
                kappas[:, path_index] = candidates[frame_index, best]
            grid_step *= 0.25

        channel_atoms = _path_atoms_batch(self.cfg, cell_delay, cell_doppler, kappas)
        sensing = np.einsum("ml,bkl->bmk", self.phi, channel_atoms, optimize=True)
        gains = self._regularized_gain_batch(sensing, observations, regularizer)
        refined = np.einsum("bkl,bk->bl", channel_atoms, gains, optimize=True)

        finite = np.all(np.isfinite(refined), axis=1)
        return np.where(finite[:, None], refined, initial_estimates)


def calibrate_estimated_path_refinement(
    model,
    observations: np.ndarray,
    targets: np.ndarray,
    noise_variance: np.ndarray,
    cfg: Config,
    design: PilotDesign,
    device,
) -> Dict[str, float]:
    """Select the refinement blend using only the validation split.

    For ``h(a)=h_FD-PGNet+a(h_param-h_FD-PGNet)``, the real scalar ``a`` that
    minimizes validation squared error has a closed form and is clipped to
    ``[0,1]``. Consequently the optional refinement must earn its contribution
    on independent validation data; no test channel or desired ranking enters.
    """
    base = infer_fdpgnet(model, observations, noise_variance, device)
    refiner = EstimatedPathRefiner(cfg, design)
    parametric = refiner.refine(observations, base, noise_variance)
    direction = parametric - base
    denominator = float(np.sum(np.abs(direction) ** 2))
    if denominator <= 1e-30:
        alpha = 0.0
    else:
        alpha = float(
            np.clip(
                np.real(np.vdot(direction, targets - base)) / denominator,
                0.0,
                1.0,
            )
        )
    blended = base + alpha * direction
    target_energy = max(float(np.sum(np.abs(targets) ** 2)), 1e-30)
    base_nmse = float(np.sum(np.abs(base - targets) ** 2) / target_energy)
    parametric_nmse = float(
        np.sum(np.abs(parametric - targets) ** 2) / target_energy
    )
    blended_nmse = float(np.sum(np.abs(blended - targets) ** 2) / target_energy)
    model.refinement_alpha = alpha
    return {
        "alpha": alpha,
        "base_validation_nmse": base_nmse,
        "parametric_validation_nmse": parametric_nmse,
        "blended_validation_nmse": blended_nmse,
    }


def count_parameters(model) -> int:
    return int(sum(p.numel() for p in model.parameters() if p.requires_grad))

